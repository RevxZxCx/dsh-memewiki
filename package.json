{
  "name": "dsh-memewiki",
  "version": "0.2.0",
  "description": "梗百科（本机 fork 版）：6792+ 条梗/黑话词库，问到梗时自动查词并注入上下文。本 fork 只自用，不同步上游。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "data",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "meme",
    "梗百科",
    "meme-wiki"
  ],
  "author": "thawline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RevxZxCx/dsh-memewiki.git"
  },
  "homepage": "https://github.com/RevxZxCx/dsh-memewiki#readme",
  "bugs": {
    "url": "https://github.com/RevxZxCx/dsh-memewiki/issues"
  },
  "memeWikiUpstream": "https://github.com/thawline/dsh-memewiki"
}
